{
  "name": "skincare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "icons": "node scripts/build-icons.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "wrangler:dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:apply:local": "wrangler d1 execute skincare-db --local --file=./schema.sql",
    "db:apply:remote": "wrangler d1 execute skincare-db --remote --file=./schema.sql"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^1.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251001.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "sharp": "^0.35.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  }
}
