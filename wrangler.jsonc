{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "summer",
  "compatibility_date": "2026-05-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "main": "src/index.js",
  "routes": [
    { "pattern": "betofabri.com/summer/*", "zone_name": "betofabri.com" }
  ],
  "kv_namespaces": [
    { "binding": "STRAVA_KV", "id": "55df805cdf85447aae99fa26ad7a0f79" }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/app/api/*", "/summer/*"]
  }
}
